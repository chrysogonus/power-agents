{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"@GUARDS@protect-tests.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"@GUARDS@protect-secrets.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
