{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@VERIFY_GATE@\" mark --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"@VERIFY_GATE@\" stop --agent claude",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
