# Require approval before the repository-local pytest executable runs unsandboxed.
prefix_rule(
    pattern = [".venv/bin/pytest"],
    decision = "prompt",
    justification = "Repository-controlled executables and tests must not run unsandboxed without approval.",
    match = [
        ".venv/bin/pytest",
        ".venv/bin/pytest tests/test_example.py",
    ],
    not_match = [
        "python -m pytest",
    ],
)
